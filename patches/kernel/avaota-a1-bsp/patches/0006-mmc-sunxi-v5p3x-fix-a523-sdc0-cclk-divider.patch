--- a/bsp/drivers/mmc/sunxi-mmc-v5p3x.c
+++ b/bsp/drivers/mmc/sunxi-mmc-v5p3x.c
@@ -459,10 +459,22 @@ static int sunxi_mmc_clk_set_rate_for_sdmmc_v5p3x(struct sunxi_mmc_host *host,
 		__sunxi_mmc_do_oclk_onoff(host, 0, 0, 1);
 		return 0;
 	}
+
+	/*
+	 * SMHC0 on A523/T527 cannot use CCLK_DIV=0 reliably. U-Boot must
+	 * leave this divider at /2 for the SD slot; with zero the clock gate
+	 * appears enabled, but the card does not see commands. Request twice
+	 * the normal module clock and use CCLK_DIV=/2 so ios->clock remains
+	 * unchanged. Limit this quirk to sdc0; the eMMC controller has its own
+	 * clock path and timing setup.
+	 */
 	if (sunxi_mmc_ddr_timing(ios->timing) || (ios->timing == MMC_TIMING_MMC_HS400)) {
 		mod_clk = ios->clock << 2;
 		div = 1;
+	} else if (host->phy_index == 0) {
+		mod_clk = ios->clock << 2;
+		div = 1;
 	} else {
 		mod_clk = ios->clock << 1;
 		div = 0;
 	}
